# --- server-only secrets (never prefix with NEXT_PUBLIC_) -----------------------------------------
# AWS RDS PostgreSQL, Mumbai (ap-south-1). connection_limit=1 for serverless; use RDS Proxy for scale.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-INSTANCE.xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/swanschool?sslmode=require&connection_limit=1&pool_timeout=20"
# Long random string used to sign login sessions:  openssl rand -hex 32
AUTH_SECRET="generate-a-long-random-string"
DB_BACKUP_RETENTION_DAYS="7"
# Optional: which school's branding the login page shows
DEFAULT_SCHOOL_SLUG="swan-school"

# --- public, harmless ------------------------------------------------------------------------------
NEXT_PUBLIC_SWAN_WEBSITE="https://swandigitalsolutions.com"
NEXT_PUBLIC_SHOW_DEMO="false"
